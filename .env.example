# Copy to `.env` for local Docker usage. Do not commit the real `.env`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
APP_DB_NAME=appdb
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app-password
BARMAN_DB_USER=barman
BARMAN_DB_PASSWORD=change-me-barman-password

# Flask app secrets (use long random values)
DATABASE_SERVER_SECRET_KEY=change-me-database-server-secret
PROXY_CLONE_SECRET_KEY=change-me-proxy-clone-secret

# Optional production override (should remain false unless explicitly demoing proxy features)
PROXY_FEATURES_ENABLED=false

# Optional migration override (otherwise Alembic uses DATABASE_URL/POSTGRES_DSN/SQLITE_DB_PATH)
# ALEMBIC_DATABASE_URL=sqlite:////absolute/path/to/database_server/data/database.db
